---
// The homepage. Section order and reasoning: PLAN.md §6.
import Base from '../layouts/Base.astro';
import PromoBar from '../components/PromoBar.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import CategoryTiles from '../components/CategoryTiles.astro';
import ProductTabs from '../components/ProductTabs.astro';
import PriceTiles from '../components/PriceTiles.astro';
import PromoBanners from '../components/PromoBanners.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Reviews from '../components/Reviews.astro';
import Newsletter from '../components/Newsletter.astro';
import AboutFaq from '../components/AboutFaq.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
import MobileMenu from '../components/MobileMenu.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import QuickAdd from '../components/QuickAdd.astro';
import BagDrawer from '../components/BagDrawer.astro';
import WishlistDrawer from '../components/WishlistDrawer.astro';
---

<Base
  title="Wholesale Clothing UK | Wholesale Shopping"
  description="Wholesale fashion for UK boutiques, online sellers and market traders. Shop new-in styles in packs, with free UK mainland delivery over £300."
>
  <a class="skip-link" href="#main">Skip to content</a>
  <PromoBar />
  <Header />

  <main id="main">
    <Hero />
    <TrustStrip />
    <CategoryTiles />
    <ProductTabs />
    <PriceTiles />
    <PromoBanners />
    <HowItWorks />
    <Reviews />
    <Newsletter />
    <AboutFaq />
  </main>

  <Footer />
  <BottomNav />

  <MobileMenu />
  <SearchOverlay />
  <QuickAdd />
  <BagDrawer />
  <WishlistDrawer />
</Base>
