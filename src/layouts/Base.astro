---
import '@fontsource-variable/inter';
// Preloading the body font avoids text reflowing (layout shift) when it arrives late.
// The display font is embedded in the page's CSS instead (see tokens.css).
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/overlays.css';

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Concept prototype: keep it out of search results so it never competes with the real site -->
    <meta name="robots" content="noindex, nofollow" />
    <!-- Lets CSS add enhancements (like scroll reveals) only when JavaScript is running -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/reveal.js';
    </script>
  </body>
</html>
