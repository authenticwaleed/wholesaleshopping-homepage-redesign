---
// Mobile menu (PLAN.md §6.3): a left drawer with Fashion Nova-style department tabs, big rows,
// quick routes at the top and contact details at the bottom.
import Icon from './Icon.astro';
import { REGISTER_URL, STORE, collectionUrl, contact, mainNav } from '../data/content.js';

const departments = mainNav.filter((item) => item.columns && item.label !== 'New In');
const featured = [
  { label: 'New In', href: collectionUrl('new-wholesale-clothing') },
  { label: 'Best Sellers', href: collectionUrl('best-seller') },
  { label: 'Sale', href: collectionUrl('clearance') },
];
---

<dialog class="drawer drawer--left" id="menu" aria-labelledby="menu-heading">
  <div class="panel">
    <div class="panel__head">
      <h2 class="visually-hidden" id="menu-heading">Menu</h2>
      <img src="/logo.svg" alt="" width="110" height="30" />
      <button class="icon-btn" type="button" data-close aria-label="Close menu">
        <Icon name="close" />
      </button>
    </div>

    <div class="panel__body">
      <ul class="menu-featured" role="list">
        {
          featured.map((f) => (
            <li>
              <a href={f.href}>{f.label}</a>
            </li>
          ))
        }
      </ul>

      <div class="menu-tabs" data-tabs>
        <div class="menu-tabs__list" role="tablist" aria-label="Departments">
          {
            departments.map((d, i) => (
              <button
                type="button"
                role="tab"
                id={`menu-tab-${i}`}
                aria-controls={`menu-panel-${i}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
              >
                {d.label}
              </button>
            ))
          }
        </div>
        {
          departments.map((d, i) => (
            <div class="menu-panel" role="tabpanel" id={`menu-panel-${i}`} aria-labelledby={`menu-tab-${i}`} hidden={i !== 0}>
              <a class="menu-row menu-row--all" href={d.href}>
                Shop all {d.label}
                <Icon name="chevron-right" size={18} />
              </a>
              {d.columns.map((col) => (
                <div class="menu-group">
                  <p class="menu-group__title">{col.title}</p>
                  <ul role="list">
                    {col.links.map((l) => (
                      <li>
                        <a class="menu-row" href={l.href}>
                          {l.label}
                          <Icon name="chevron-right" size={18} />
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </div>

    <div class="panel__foot menu-foot">
      <div class="menu-foot__account">
        <a class="btn btn--block" href={REGISTER_URL}>Register a trade account</a>
        <a class="btn btn--outline btn--block" href={`${STORE}/account/login`}>Log in</a>
      </div>
      <ul class="menu-foot__contact" role="list">
        <li><a href={contact.phone.href}>{contact.phone.label}</a></li>
        <li><a href={contact.whatsapp.href} target="_blank" rel="noopener">{contact.whatsapp.label}</a></li>
        <li class="menu-foot__hours">{contact.hours}</li>
      </ul>
    </div>
  </div>
</dialog>

<script>
  import '../scripts/menu.js';
</script>

<style>
  .panel__head img {
    width: 110px;
    height: auto;
  }

  .menu-featured {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
  }

  .menu-featured a {
    display: grid;
    place-items: center;
    min-height: 48px;
    padding-inline: var(--space-1);
    background: var(--surface);
    font-size: var(--text-xs);
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .menu-featured li:last-child a {
    color: var(--accent);
  }

  .menu-tabs__list {
    display: flex;
    gap: var(--space-5);
    padding-inline: var(--space-5);
    border-bottom: 1px solid var(--line);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .menu-tabs__list button {
    flex: none;
    min-height: 48px;
    padding: 0;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--muted);
  }

  .menu-tabs__list button[aria-selected='true'] {
    border-bottom-color: var(--ink);
    color: var(--ink);
  }

  .menu-panel {
    padding: var(--space-2) var(--space-5) var(--space-6);
  }

  .menu-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 48px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .menu-row :global(svg) {
    color: var(--muted);
  }

  .menu-row--all {
    font-weight: 700;
  }

  .menu-group__title {
    margin-top: var(--space-5);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .menu-foot {
    display: grid;
    gap: var(--space-4);
  }

  .menu-foot__account {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-2);
  }

  .menu-foot__account .btn {
    padding-inline: var(--space-2);
    font-size: var(--text-xs);
  }

  .menu-foot__contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    font-size: var(--text-sm);
  }

  .menu-foot__contact a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
  }

  .menu-foot__hours {
    width: 100%;
    font-size: var(--text-xs);
    color: var(--muted);
  }
</style>
