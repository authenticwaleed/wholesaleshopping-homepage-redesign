---
// Reviews (PLAN.md §6.14): real Trustpilot rating and recent reviews (notes/real-facts.md §1).
import Icon from './Icon.astro';
import { reviews } from '../data/content.js';
---

<section class="section container" aria-labelledby="reviews-title" data-reveal>
  <div class="section-head">
    <div>
      <h2 class="section-title" id="reviews-title">Rated {reviews.label} on Trustpilot</h2>
      <p class="reviews__summary">
        <span class="stars" aria-hidden="true">
          {Array.from({ length: 5 }, () => <Icon name="star" size={16} fill="currentColor" stroke-width="0" />)}
        </span>
        <strong>{reviews.score} out of 5</strong> from {reviews.count} reviews
      </p>
    </div>
    <a class="link-more" href={reviews.href} target="_blank" rel="noopener">Read all reviews</a>
  </div>
  <ul class="rail reviews" role="list">
    {
      reviews.items.map((r) => (
        <li>
          <figure class="review">
            <span class="stars" role="img" aria-label="5 out of 5 stars">
              {Array.from({ length: 5 }, () => <Icon name="star" size={14} fill="currentColor" stroke-width="0" />)}
            </span>
            <blockquote class="review__text">“{r.text}”</blockquote>
            <figcaption class="review__by">
              {r.name} · {r.date}
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .reviews__summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    font-size: var(--text-sm);
  }

  .stars {
    display: inline-flex;
    gap: 2px;
  }

  .reviews {
    grid-auto-columns: 80%;
  }

  @media (min-width: 600px) {
    .reviews {
      grid-auto-columns: 45%;
    }
  }

  @media (min-width: 900px) {
    .reviews {
      grid-auto-columns: calc((100% - 3 * var(--space-3)) / 4);
    }
  }

  .review {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    height: 100%;
    margin: 0;
    padding: var(--space-5);
    border: 1px solid var(--line);
  }

  .review__text {
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.5;
  }

  .review__by {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--muted);
  }
</style>
