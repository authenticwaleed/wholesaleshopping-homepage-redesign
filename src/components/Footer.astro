---
// Footer (PLAN.md §6.17): link columns fold into accordions on phones; contact details and
// accepted payments up front, then legal details and a note that this is a concept.
import { contact, footerLinks, legal, paymentMethods, social, TRUSTPILOT_URL } from '../data/content.js';
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <img src="/logo.svg" alt="Wholesale Shopping" width="160" height="44" loading="lazy" />
      <p>Wholesale fashion for UK boutiques, online sellers and market traders, from our Manchester warehouse.</p>
      <ul class="footer__contact" role="list">
        <li><a href={contact.phone.href}>{contact.phone.label}</a></li>
        <li><a href={contact.whatsapp.href} target="_blank" rel="noopener">{contact.whatsapp.label}</a></li>
        <li><a href={contact.email.href}>{contact.email.label}</a></li>
        <li class="footer__muted">{contact.hours}</li>
        <li class="footer__muted">{contact.address}</li>
      </ul>
    </div>

    {
      footerLinks.map((group) => (
        <details class="footer__group" data-footer-group>
          <summary>{group.title}</summary>
          <ul role="list">
            {group.links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        </details>
      ))
    }
  </div>

  <div class="container footer__row">
    <ul class="footer__social" role="list" aria-label="Social media">
      {
        social.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener">
              {s.label}
            </a>
          </li>
        ))
      }
      <li><a href={TRUSTPILOT_URL} target="_blank" rel="noopener">Trustpilot</a></li>
    </ul>
    <ul class="footer__payments" role="list" aria-label="Payment methods">
      {paymentMethods.map((m) => <li>{m}</li>)}
    </ul>
  </div>

  <div class="container footer__legal">
    <p>© 2026 {legal.company} · Company no. {legal.companyNumber} · VAT {legal.vat}</p>
    <p>
      Homepage concept for the NaskSoft assessment. Products, prices and checkout come from wholesaleshopping.co.uk.
    </p>
  </div>
</footer>

<script>
  // Link groups are accordions on phones and always open on desktop
  const wide = matchMedia('(min-width: 900px)');
  const sync = () => document.querySelectorAll('[data-footer-group]').forEach((d) => (d.open = wide.matches));
  wide.addEventListener('change', sync);
  sync();
</script>

<style>
  /* On phones the extra bottom padding keeps the end of the page clear of the fixed bottom bar
     (BottomNav.astro, 56px), while staying dark instead of leaving a white strip */
  .footer {
    padding-block: var(--space-8) calc(var(--space-6) + 56px + env(safe-area-inset-bottom));
    background: var(--ink);
    color: var(--paper);
    font-size: var(--text-sm);
  }

  @media (min-width: 900px) {
    .footer {
      padding-bottom: var(--space-6);
    }
  }

  .footer a {
    text-decoration: none;
  }

  .footer a:hover {
    text-decoration: underline;
  }

  .footer__grid {
    display: grid;
  }

  .footer__brand {
    display: grid;
    gap: var(--space-4);
    padding-bottom: var(--space-6);
  }

  /* The logo is near-black; invert it for the dark footer */
  .footer__brand img {
    width: 160px;
    height: auto;
    filter: invert(1);
  }

  .footer__brand > p {
    max-width: 40ch;
    color: rgb(255 255 255 / 0.75);
  }

  .footer__contact {
    display: grid;
    gap: var(--space-1);
  }

  .footer__contact a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }

  .footer__muted {
    color: rgb(255 255 255 / 0.65);
  }

  .footer__group {
    border-top: 1px solid rgb(255 255 255 / 0.15);
  }

  .footer__group summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 52px;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
  }

  .footer__group summary::-webkit-details-marker {
    display: none;
  }

  .footer__group summary::after {
    content: '+';
    font-size: 1.25rem;
    font-weight: 400;
  }

  .footer__group[open] summary::after {
    content: '−';
  }

  .footer__group ul {
    display: grid;
    gap: var(--space-1);
    padding-bottom: var(--space-4);
  }

  .footer__group a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    color: rgb(255 255 255 / 0.85);
  }

  .footer__row {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid rgb(255 255 255 / 0.15);
  }

  .footer__social,
  .footer__payments {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }

  /* min-width so short names like "X" are still easy to tap */
  .footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
  }

  .footer__payments li {
    padding: var(--space-1) var(--space-2);
    border: 1px solid rgb(255 255 255 / 0.3);
    border-radius: var(--radius-s);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .footer__legal {
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-6);
    font-size: var(--text-xs);
    color: rgb(255 255 255 / 0.6);
  }

  @media (min-width: 900px) {
    .footer__grid {
      grid-template-columns: 2fr repeat(3, 1fr);
      gap: var(--space-8);
    }

    .footer__group {
      border-top: 0;
    }

    .footer__group summary {
      min-height: 0;
      margin-bottom: var(--space-3);
      cursor: default;
      pointer-events: none;
    }

    .footer__group summary::after,
    .footer__group[open] summary::after {
      content: none;
    }

    .footer__row {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }
</style>
