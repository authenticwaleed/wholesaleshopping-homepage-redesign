---
// Search panel (PLAN.md §6.4): full screen on phones, a panel under the top edge on desktop.
// Results are drawn by src/scripts/search.js, so styles are global (.search-*).
import Icon from './Icon.astro';
import { STORE, popularSearches, quickLinks } from '../data/content.js';
---

<dialog class="search-dialog" id="search" aria-label="Search">
  <div class="panel">
    <form class="search-form container" action={`${STORE}/search`} method="get" role="search">
      <Icon name="search" size={20} />
      <label class="visually-hidden" for="search-field">Search wholesale styles</label>
      <input
        id="search-field"
        type="search"
        name="q"
        placeholder="Search dresses, jumpers, boots…"
        autocomplete="off"
        enterkeyhint="search"
        data-search-field
      />
      <button class="icon-btn" type="button" data-close aria-label="Close search">
        <Icon name="close" />
      </button>
    </form>

    <div class="panel__body">
      <div class="search-body container">
        <div data-search-suggestions>
          <p class="search-label">Popular searches</p>
          <ul class="search-chips" role="list">
            {
              popularSearches.map((term) => (
                <li>
                  <button class="chip" type="button" data-search-term={term}>
                    {term}
                  </button>
                </li>
              ))
            }
          </ul>
          <p class="search-label">Shop quickly</p>
          <ul class="search-chips" role="list">
            {
              quickLinks.map((l) => (
                <li>
                  <a class="chip" href={l.href}>
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div data-search-results hidden>
          <p class="search-label" data-search-summary aria-live="polite"></p>
          <ul class="search-results" role="list" data-search-list></ul>
          <a class="btn btn--outline btn--block" href="#" data-search-all>See all results</a>
        </div>
      </div>
    </div>
  </div>
</dialog>

<script>
  import '../scripts/search.js';
</script>

<style is:global>
  .search-dialog {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
  }

  .search-dialog > .panel {
    height: 100%;
  }

  .search-form {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line);
  }

  .search-form > svg {
    position: absolute;
    left: calc(var(--gutter) + 14px);
    color: var(--muted);
    pointer-events: none;
  }

  .search-form input {
    flex: 1;
    min-width: 0;
    min-height: 48px;
    padding: 0 var(--space-4) 0 44px;
    border: 1px solid var(--ink);
    border-radius: var(--radius-pill);
    font-size: var(--text-base);
  }

  .search-body {
    padding-block: var(--space-5) var(--space-8);
  }

  .search-label {
    margin-bottom: var(--space-3);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .search-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .search-results {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .search-hit {
    display: grid;
    grid-template-columns: 64px 1fr;
    grid-template-rows: auto auto;
    align-content: center;
    column-gap: var(--space-4);
    padding: var(--space-2);
    border-radius: var(--radius-m);
    text-decoration: none;
  }

  .search-hit:hover,
  .search-hit:focus-visible {
    background: var(--surface);
  }

  .search-hit img {
    grid-row: 1 / span 2;
    width: 64px;
    aspect-ratio: 2 / 3;
    height: auto;
    object-fit: cover;
    background: var(--surface);
  }

  .search-hit__title {
    align-self: end;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .search-hit__price {
    align-self: start;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  @media (min-width: 900px) {
    .search-dialog {
      height: auto;
      max-height: 80vh;
    }

    .search-dialog > .panel {
      max-height: 80vh;
    }

    .search-results {
      grid-template-columns: repeat(2, 1fr);
      column-gap: var(--space-6);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .search-dialog[open] > .panel {
      animation: rise var(--dur-base) var(--ease-out);
    }
  }
</style>
