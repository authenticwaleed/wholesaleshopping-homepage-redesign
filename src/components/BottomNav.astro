---
// Bottom bar on phones (PLAN.md §6.18): the main actions within thumb reach.
// The buttons reuse the same data-open-* hooks as the header, so counts and panels stay in sync.
import Icon from './Icon.astro';
import { STORE } from '../data/content.js';
---

<nav class="bottom-nav" aria-label="Shortcuts">
  <button type="button" data-open-menu>
    <Icon name="menu" size={22} />
    <span>Shop</span>
  </button>
  <button type="button" data-open-search>
    <Icon name="search" size={22} />
    <span>Search</span>
  </button>
  <button type="button" data-open-wishlist>
    <Icon name="heart" size={22} />
    <span>Saved</span>
    <span class="count-badge" data-wishlist-count data-count="0" aria-hidden="true">0</span>
  </button>
  <button type="button" data-open-bag>
    <Icon name="bag" size={22} />
    <span>Bag</span>
    <span class="count-badge" data-bag-count data-count="0" aria-hidden="true">0</span>
  </button>
  <a href={`${STORE}/account`}>
    <Icon name="user" size={22} />
    <span>Account</span>
  </a>
</nav>

<style>
  .bottom-nav {
    position: fixed;
    inset: auto 0 0 0;
    z-index: var(--z-bottom-nav);
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    padding-bottom: env(safe-area-inset-bottom);
    border-top: 1px solid var(--line);
    background: var(--paper);
  }

  .bottom-nav > * {
    position: relative;
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 2px;
    min-height: 56px;
    padding: 0;
    border: 0;
    background: none;
    font-size: 11px;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }

  .bottom-nav .count-badge {
    top: 4px;
    right: calc(50% - 22px);
  }

  /* The footer reserves room underneath for this bar (see Footer.astro), so nothing is hidden behind it */

  @media (min-width: 900px) {
    .bottom-nav {
      display: none;
    }
  }
</style>
