---
// Bag drawer (PLAN.md §6.10). Lines and totals are drawn by src/scripts/bag.js, so styles are global (.bag-*).
import Icon from './Icon.astro';
import { collectionUrl } from '../data/content.js';
---

<dialog class="drawer" id="bag" aria-labelledby="bag-heading">
  <div class="panel">
    <div class="panel__head">
      <h2 class="panel__title" id="bag-heading">Your bag <span data-bag-heading-count></span></h2>
      <button class="icon-btn" type="button" data-close aria-label="Close bag">
        <Icon name="close" />
      </button>
    </div>

    <div class="bag-progress" data-bag-progress aria-live="polite"></div>

    <div class="panel__body">
      <ul class="bag-lines" role="list" data-bag-lines></ul>
      <div class="bag-empty" data-bag-empty>
        <p class="bag-empty__title">Your bag is empty</p>
        <p class="bag-empty__text">Use Quick add on any product to build your order here.</p>
        <a class="btn" href={collectionUrl('new-wholesale-clothing')}>Shop New In</a>
        <a class="btn btn--outline" href={collectionUrl('best-seller')}>Best Sellers</a>
      </div>
    </div>

    <div class="panel__foot" data-bag-foot hidden>
      <p class="bag-subtotal"><span>Subtotal</span> <strong data-bag-subtotal></strong></p>
      <p class="bag-note">Prices exclude VAT. VAT and delivery are added at checkout.</p>
      <a class="btn btn--block" href="#" data-checkout>Checkout</a>
      <p class="bag-note">You'll finish your order securely on wholesaleshopping.co.uk.</p>
    </div>
  </div>
</dialog>

<script>
  import '../scripts/bag.js';
</script>

<style is:global>
  .bag-progress {
    padding: var(--space-4) var(--space-5) var(--space-5);
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }

  .bag-progress__text {
    margin-bottom: var(--space-3);
    font-size: var(--text-sm);
  }

  .bag-progress__track {
    position: relative;
    height: 6px;
    border-radius: var(--radius-pill);
    background: var(--line);
  }

  .bag-progress__fill {
    position: absolute;
    inset: 0 auto 0 0;
    border-radius: inherit;
    background: var(--ink);
    transition: width var(--dur-slow) var(--ease-out);
  }

  .bag-progress__fill.is-done {
    background: var(--success);
  }

  /* Marker for the £100 minimum order on the way to £300 */
  .bag-progress__mark {
    position: absolute;
    top: 50%;
    width: 12px;
    height: 12px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--paper);
    transform: translate(-50%, -50%);
  }

  .bag-progress__mark.is-done {
    background: var(--ink);
  }

  .bag-progress__labels {
    position: relative;
    height: 1.2em;
    margin-top: var(--space-2);
    font-size: 11px;
    color: var(--muted);
  }

  .bag-progress__labels span {
    position: absolute;
    top: 0;
    white-space: nowrap;
  }

  .bag-progress__labels span:first-child {
    transform: translateX(-50%);
  }

  .bag-progress__labels span:last-child {
    right: 0;
  }

  .bag-lines {
    padding-inline: var(--space-5);
  }

  .bag-line {
    display: grid;
    grid-template-columns: 80px 1fr auto;
    gap: var(--space-3) var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--line);
  }

  .bag-line__photo img {
    width: 80px;
    aspect-ratio: 2 / 3;
    height: auto;
    object-fit: cover;
    background: var(--surface);
  }

  .bag-line__info {
    display: grid;
    align-content: start;
    gap: 2px;
    min-width: 0;
  }

  .bag-line__title {
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.35;
    text-decoration: none;
  }

  .bag-line__meta {
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .bag-line__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .stepper--small {
    grid-template-columns: 40px 2.5rem 40px;
  }

  .stepper--small button,
  .stepper--small input {
    height: 40px;
  }

  .bag-line__remove {
    min-height: var(--tap);
    padding: 0 var(--space-1);
    border: 0;
    background: none;
    font-size: var(--text-xs);
    text-decoration: underline;
    color: var(--muted);
  }

  .bag-line__total {
    font-size: var(--text-sm);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .bag-empty {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-8) var(--space-5);
    text-align: center;
  }

  .bag-empty[hidden] {
    display: none;
  }

  .bag-empty__title {
    font-family: var(--font-display);
    font-stretch: 75%;
    font-size: var(--text-xl);
    font-weight: 800;
    text-transform: uppercase;
  }

  .bag-empty__text {
    margin-bottom: var(--space-3);
    color: var(--muted);
  }

  .bag-subtotal {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-lg);
  }

  .bag-note {
    margin-block: var(--space-2);
    font-size: var(--text-xs);
    color: var(--muted);
    text-align: center;
  }

  [data-checkout].is-disabled {
    background: var(--muted);
    border-color: var(--muted);
    cursor: not-allowed;
  }
</style>
