---
// Quick Add (PLAN.md §6.9): a bottom sheet on phones and a centred window on desktop.
// Its contents are drawn by src/scripts/quick-add.js, so the styles below are global (prefixed .qa).
import Icon from './Icon.astro';
---

<dialog class="sheet" id="quick-add" aria-labelledby="quick-add-heading">
  <div class="panel">
    <div class="panel__head">
      <p class="panel__title" id="quick-add-heading">Quick add</p>
      <button class="icon-btn" type="button" data-close aria-label="Close">
        <Icon name="close" />
      </button>
    </div>
    <div class="panel__body" data-quick-add-body></div>
  </div>
</dialog>

<script>
  import '../scripts/quick-add.js';
</script>

<style is:global>
  .qa {
    display: grid;
    grid-template-columns: 112px 1fr;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5) var(--space-6);
  }

  /* The card's already-loaded photo shows instantly as a background; the sharper one fades in over it */
  .qa__media {
    align-self: start;
    aspect-ratio: 2 / 3;
    background: var(--surface) center / cover no-repeat;
  }

  .qa__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--dur-base);
  }

  .qa__media img.is-loaded {
    opacity: 1;
  }

  .qa__details {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    min-width: 0;
  }

  /* On phones the form spans the full width under the photo and title */
  @media (max-width: 899px) {
    .qa__details {
      display: contents;
    }

    .qa__origin,
    .qa__title,
    .qa__price {
      grid-column: 2;
    }

    .qa__media {
      grid-row: 1 / span 3;
    }

    .qa__group,
    .qa__qty,
    .qa__buy,
    .qa__more,
    .qa__note {
      grid-column: 1 / -1;
    }

    /* The total and Add to bag button stay pinned to the bottom of the sheet while choosing options */
    .qa__buy {
      position: sticky;
      bottom: 0;
      z-index: 1;
      margin-inline: calc(var(--space-5) * -1);
      padding: var(--space-3) var(--space-5) calc(var(--space-3) + env(safe-area-inset-bottom));
      border-top: 1px solid var(--line);
      background: var(--paper);
    }
  }

  .qa__buy {
    display: grid;
    gap: var(--space-2);
  }

  .qa__origin {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .qa__title {
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.3;
  }

  .qa__price {
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .qa__price strong {
    font-size: var(--text-xl);
    color: var(--ink);
  }

  .qa__group {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .qa__label {
    display: block;
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .qa__options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* Some products come in 40+ colours: keep the list compact and scrollable */
  .qa__options--colours {
    max-height: 9.5rem;
    overflow-y: auto;
    padding: 2px;
  }

  .option--pack > span {
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    border-radius: var(--radius-m);
    padding: var(--space-2) var(--space-4);
    line-height: 1.35;
  }

  .option--pack small {
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .qa__best {
    margin-top: 2px;
    font-size: 10px;
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--success);
  }

  .qa__qty {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .qa__qty .qa__label {
    margin: 0;
  }

  .qa__total {
    min-height: 1.5em;
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .qa [data-qa-add]:disabled {
    background: var(--muted);
    border-color: var(--muted);
    cursor: not-allowed;
  }

  .qa__more {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: var(--tap);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .qa__note {
    font-size: var(--text-xs);
    color: var(--muted);
    text-align: center;
  }

  .qa__status {
    padding: var(--space-8) var(--space-5);
    text-align: center;
    color: var(--muted);
  }

  @media (min-width: 900px) {
    .qa {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--space-7);
      padding: var(--space-6) var(--space-7) var(--space-7);
    }

    .qa__title {
      font-size: var(--text-xl);
    }
  }
</style>
