---
// "Shop the latest" (PLAN.md §6.8): Fashion Nova's tabbed product row, with wholesale product cards.
import Icon from './Icon.astro';
import ProductCard from './ProductCard.astro';
import { productTabs } from '../lib/catalogue.js';

const SHOWN = 12;
---

<section class="section container" aria-labelledby="latest-title" data-tabs data-reveal>
  <div class="section-head">
    <div>
      <h2 class="section-title" id="latest-title">Shop the latest</h2>
      <p class="section-note">Prices per piece, excluding VAT</p>
    </div>
    <div class="latest__arrows">
      <button class="icon-btn latest__arrow" type="button" aria-label="Scroll products left" data-rail-prev>
        <Icon name="chevron-left" />
      </button>
      <button class="icon-btn latest__arrow" type="button" aria-label="Scroll products right" data-rail-next>
        <Icon name="chevron-right" />
      </button>
    </div>
  </div>

  <div class="latest__tabs" role="tablist" aria-label="Product groups">
    {
      productTabs.map((tab, i) => (
        <button
          class="latest__tab"
          type="button"
          role="tab"
          id={`tab-${tab.key}`}
          aria-controls={`panel-${tab.key}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          {tab.label}
        </button>
      ))
    }
  </div>

  {
    productTabs.map((tab, i) => (
      <div class="latest__panel" role="tabpanel" id={`panel-${tab.key}`} aria-labelledby={`tab-${tab.key}`} hidden={i !== 0}>
        <div class="rail latest__rail" data-rail>
          {tab.items.slice(0, SHOWN).map((product, n) => (
            <ProductCard product={product} eager={i === 0 && n < 2} />
          ))}
          <a class="latest__all" href={tab.url}>
            <span>View all {tab.label}</span>
            <Icon name="arrow-right" />
          </a>
        </div>
      </div>
    ))
  }
</section>

<script>
  import '../scripts/tabs.js';
</script>

<style>
  .latest__arrows {
    display: none;
  }

  .latest__tabs {
    display: flex;
    gap: var(--space-2);
    margin: 0 calc(var(--gutter) * -1) var(--space-5);
    padding-inline: var(--gutter);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .latest__tabs::-webkit-scrollbar {
    display: none;
  }

  .latest__tab {
    flex: none;
    min-height: 40px;
    padding: 0 var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--paper);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .latest__tab[aria-selected='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .latest__rail {
    grid-auto-columns: 44%;
    gap: var(--space-3);
  }

  .latest__all {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-3);
    aspect-ratio: 2 / 3;
    padding: var(--space-4);
    background: var(--surface);
    font-family: var(--font-display);
    font-stretch: 75%;
    font-size: var(--text-xl);
    font-weight: 800;
    text-align: center;
    text-transform: uppercase;
    text-decoration: none;
  }

  .latest__all:hover {
    background: var(--ink);
    color: var(--paper);
  }

  @media (min-width: 600px) {
    .latest__rail {
      grid-auto-columns: 30%;
    }
  }

  @media (min-width: 900px) {
    .latest__arrows {
      display: flex;
      gap: var(--space-2);
    }

    .latest__arrow {
      border: 1px solid var(--line);
      border-radius: 50%;
    }

    .latest__arrow:hover {
      border-color: var(--ink);
    }

    .latest__rail {
      grid-auto-columns: calc((100% - 3 * var(--space-4)) / 4);
      gap: var(--space-4);
    }

    .latest__tabs {
      gap: var(--space-6);
      margin-inline: 0;
      padding-inline: 0;
      border-bottom: 1px solid var(--line);
    }

    .latest__tab {
      min-height: var(--tap);
      padding: 0;
      border: 0;
      border-bottom: 2px solid transparent;
      border-radius: 0;
      background: none;
      color: var(--muted);
      letter-spacing: var(--tracking-caps);
      text-transform: uppercase;
    }

    .latest__tab:hover {
      color: var(--ink);
    }

    .latest__tab[aria-selected='true'] {
      background: none;
      color: var(--ink);
      border-bottom-color: var(--ink);
    }
  }

  @media (min-width: 1200px) {
    .latest__rail {
      grid-auto-columns: calc((100% - 4 * var(--space-4)) / 5);
    }
  }
</style>
